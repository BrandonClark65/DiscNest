{
  "name": "discnest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "seed": "ts-node -P tsconfig.seed.json scripts/seed/seedDiscs.ts",
    "seed:pros": "ts-node -P tsconfig.seed.json scripts/seed/seedProPlayers.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:report": "vitest run --coverage && node scripts/coverage-tracker.js",
    "test:coverage:html": "vitest run --coverage && echo Coverage report generated at ./coverage/index.html",
    "test:coverage:open": "start coverage/coverage-history.html"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@google-cloud/vision": "^5.3.3",
    "@react-email/render": "^1.3.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-node": "^4.22.0",
    "@vercel/analytics": "^1.6.1",
    "bad-words": "^4.0.0",
    "bcryptjs": "^3.0.2",
    "browser-image-compression": "^2.0.2",
    "canvas": "^3.2.0",
    "chart.js": "^4.5.0",
    "cloudinary": "^2.7.0",
    "clsx": "^2.1.1",
    "critters": "^0.0.23",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "file-type": "^21.0.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.24",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.18.2",
    "next": "15.5.9",
    "next-auth": "^4.24.11",
    "node-fetch": "^2.7.0",
    "nsfwjs": "^4.2.1",
    "openai": "^6.9.0",
    "react": "19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-tooltip": "^5.29.1",
    "resend": "^6.1.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.5",
    "@types/formidable": "^3.4.6",
    "@types/leaflet": "^1.9.21",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.14",
    "eslint": "^9",
    "eslint-config-next": "15.5.4",
    "jsdom": "^27.2.0",
    "mongodb-memory-server": "^10.3.0",
    "multer": "^2.0.2",
    "supertest": "^7.1.4",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
